# ScamShield AI — Environment Variables Configuration
# Copy this file to create your actual .env files:
#   backend/.env   (from the [BACKEND] section)
#   frontend/.env  (from the [FRONTEND] section)
# NEVER commit actual .env files to Git.

# ============================================================
# [BACKEND] — Create: scamshield-ai/backend/.env
# ============================================================
ENVIRONMENT=development
DATABASE_URL=sqlite:///./scamshield.db
JWT_SECRET_KEY=scamshield-super-secret-dev-key-change-in-prod-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
HOST=127.0.0.1

# Firebase Admin SDK (Backend — optional, enables real Firebase login)
# Set FIREBASE_PROJECT_ID to your Firebase project ID
# Set FIREBASE_CREDENTIALS_PATH to the path to your downloaded service account JSON key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ============================================================
# [FRONTEND] — Create: scamshield-ai/frontend/.env
# ============================================================
# Copy the firebaseConfig object values from Firebase Console:
# Project Settings → General → Your apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ============================================================
# NOTE: Without Firebase credentials, the app uses verified
# demo accounts automatically:
#   Analyst login:  analyst / Analyst@ScamShield2026!
#   Admin login:    admin   / Admin@ScamShield2026!
# ============================================================
